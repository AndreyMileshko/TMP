<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tmp.ui.shell.screen.roleadmin.RoleAdministrationController"
      fx:id="root"
      styleClass="tmp-screen">
    <VBox styleClass="tmp-screen-header">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox HBox.hgrow="ALWAYS" spacing="4">
                <Label text="Роли" styleClass="tmp-screen-title"/>
                <Label text="Управление ролями и правами доступа" styleClass="tmp-screen-subtitle"/>
            </VBox>
            <HBox styleClass="tmp-screen-actions" alignment="CENTER_RIGHT">
                <Button fx:id="createRoleButton" text="Создать роль" styleClass="tmp-button-action"/>
            </HBox>
        </HBox>
    </VBox>
    <VBox styleClass="tmp-content tmp-content-compact" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <SplitPane fx:id="roleSplitPane" styleClass="role-admin-split" dividerPositions="0.38" VBox.vgrow="ALWAYS">
            <VBox styleClass="role-admin-master" spacing="8">
                <Label text="Роли" styleClass="tmp-section-title"/>
                <TableView fx:id="roleTable" styleClass="tmp-table-compact" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Имя" prefWidth="140" minWidth="100"/>
                        <TableColumn fx:id="descriptionColumn" text="Описание" prefWidth="160" minWidth="100"/>
                        <TableColumn fx:id="permissionCountColumn" text="Права" prefWidth="60" minWidth="50" maxWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
            <StackPane fx:id="detailStack" styleClass="role-admin-detail">
                <VBox fx:id="detailEmptyState" styleClass="tmp-empty-state" alignment="CENTER" spacing="8">
                    <Label text="Выберите роль" styleClass="tmp-empty-state-title"/>
                    <Label text="Чтобы просмотреть и изменить её права." styleClass="tmp-empty-state-hint" wrapText="true"/>
                </VBox>
                <VBox fx:id="detailContent" spacing="12" visible="false" managed="false">
                    <padding>
                        <Insets top="4" right="8" bottom="8" left="8"/>
                    </padding>
                    <Label fx:id="selectedRoleLabel" styleClass="tmp-section-title" wrapText="true"/>
                    <Label fx:id="selectedRoleDescriptionLabel" styleClass="tmp-text-muted" wrapText="true"
                           visible="false" managed="false"/>

                    <VBox fx:id="assignmentSection" spacing="8" styleClass="role-admin-assignment">
                        <Label text="Назначение пользователю" styleClass="tmp-form-label"/>
                        <Label text="Пользователь" styleClass="tmp-text-muted"/>
                        <StackPane>
                            <TextField fx:id="userSearchField" promptText="Поиск пользователя..."/>
                            <ListView fx:id="userSearchResults" styleClass="role-admin-user-results"
                                      visible="false" managed="false" prefHeight="140" maxHeight="180"/>
                        </StackPane>
                        <CheckBox fx:id="roleAssignedCheck" text="Роль назначена пользователю"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button fx:id="applyAssignmentButton" text="Применить" styleClass="tmp-button-action"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="role-admin-permissions">
                        <Label text="Права роли" styleClass="tmp-form-label"/>
                        <TextField fx:id="permissionSearchField" promptText="Поиск прав..." maxWidth="320"/>
                        <TreeView fx:id="permissionTree" styleClass="role-admin-permission-tree" VBox.vgrow="ALWAYS"/>
                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="applyPermissionsButton" text="Применить права" styleClass="tmp-button-action"/>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
        </SplitPane>
    </VBox>
    <Label fx:id="statusLabel" styleClass="tmp-empty-state-hint" wrapText="true"/>
    <Label fx:id="errorLabel" styleClass="tmp-message-error" visible="false" managed="false" wrapText="true"/>
</VBox>
