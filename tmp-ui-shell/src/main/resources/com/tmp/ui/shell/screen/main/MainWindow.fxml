<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tmp.ui.shell.screen.main.MainWindowController"
            styleClass="main-window-root">
    <top>
        <HBox styleClass="main-window-top" alignment="CENTER_LEFT" minHeight="56" prefHeight="56" maxHeight="56">
            <padding>
                <Insets top="0" right="20" bottom="0" left="20"/>
            </padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="TMP" styleClass="main-window-brand-mark"/>
                <Label text="TOP Manufacturing Platform" styleClass="main-window-brand"/>
            </HBox>
            <HBox styleClass="main-window-history" spacing="4" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="0" right="0" bottom="0" left="16"/>
                </padding>
                <Button fx:id="historyBackButton" styleClass="main-window-history-button" focusTraversable="true">
                    <tooltip>
                        <Tooltip text="Назад"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                                 styleClass="main-window-history-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="historyForwardButton" styleClass="main-window-history-button" focusTraversable="true">
                    <tooltip>
                        <Tooltip text="Вперёд"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                                 styleClass="main-window-history-icon"/>
                    </graphic>
                </Button>
            </HBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <HBox spacing="16" alignment="CENTER_RIGHT">
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="main-window-user">
                    <Label fx:id="userAvatarLabel" styleClass="main-window-user-avatar" maxWidth="32" minWidth="32"
                           alignment="CENTER"/>
                    <Label fx:id="userLoginLabel" styleClass="main-window-user-login"/>
                </HBox>
                <Button fx:id="logoutButton" text="Выход" styleClass="main-window-logout"/>
            </HBox>
        </HBox>
    </top>
    <left>
        <VBox styleClass="main-window-sidebar" prefWidth="232" minWidth="232" maxWidth="232">
            <padding>
                <Insets top="16" right="12" bottom="16" left="12"/>
            </padding>
            <Label text="РАЗДЕЛЫ" styleClass="main-window-nav-section-title"/>
            <ListView fx:id="navigationList" styleClass="main-window-navigation" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="main-window-content">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>
