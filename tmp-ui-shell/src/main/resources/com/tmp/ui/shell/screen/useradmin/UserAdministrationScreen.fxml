<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tmp.ui.shell.screen.useradmin.UserAdministrationController"
      styleClass="tmp-screen">
    <VBox styleClass="tmp-screen-header">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox HBox.hgrow="ALWAYS" spacing="4">
                <Label text="Пользователи" styleClass="tmp-screen-title"/>
                <Label text="Управление учетными записями пользователей" styleClass="tmp-screen-subtitle"/>
            </VBox>
            <HBox styleClass="tmp-screen-actions" alignment="CENTER_RIGHT">
                <Button fx:id="createUserButton" text="Создать пользователя" styleClass="tmp-button-action"/>
            </HBox>
        </HBox>
    </VBox>
    <HBox styleClass="tmp-toolbar">
        <CheckBox fx:id="showDeletedCheckBox" text="Показывать удалённых"/>
    </HBox>
    <VBox styleClass="tmp-content tmp-content-compact" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <TableView fx:id="userTable" styleClass="tmp-table-compact" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="loginColumn" text="Логин" prefWidth="160" minWidth="120"/>
                <TableColumn fx:id="displayNameColumn" text="Имя" prefWidth="380" minWidth="150"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="120" minWidth="110" maxWidth="130"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="errorLabel" styleClass="tmp-message-error" visible="false" managed="false" wrapText="true"/>
</VBox>
