<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tmp.ui.shell.screen.orderitemlist.OrderItemListController"
      spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label fx:id="titleLabel" styleClass="order-item-list-title"/>
    <HBox spacing="8">
        <Button fx:id="createItemButton" text="Создать позицию"/>
        <Button fx:id="openItemButton" text="Открыть"/>
        <Button fx:id="backButton" text="К заказу"/>
    </HBox>
    <TableView fx:id="itemsTable" prefHeight="360">
        <columns>
            <TableColumn fx:id="productCodeColumn" text="Код изделия" prefWidth="140"/>
            <TableColumn fx:id="nameColumn" text="Наименование" prefWidth="220"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="100"/>
            <TableColumn fx:id="activeRevisionColumn" text="Активная редакция" prefWidth="140"/>
        </columns>
    </TableView>
    <Label fx:id="errorLabel" styleClass="order-item-list-error" visible="false" managed="false" wrapText="true"/>
</VBox>
