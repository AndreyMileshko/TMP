<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tmp.ui.shell.screen.production.ProductionWorkbenchController"
      spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label fx:id="titleLabel" text="Производство" style="-fx-font-size: 18px;"/>
    <Label fx:id="loadingLabel" text="Загрузка..." visible="false" managed="true"
           style="-fx-opacity: 0.85;"/>
    <Label fx:id="emptyStateLabel"/>
    <Label fx:id="statusMessageLabel"/>
    <Label fx:id="errorMessageLabel" style="-fx-text-fill: #b00020;"/>

    <VBox fx:id="treePane" spacing="8" VBox.vgrow="ALWAYS">
        <HBox spacing="8">
            <TextField fx:id="searchField" promptText="Поиск: заказ, заказчик, позиция, изделие"
                       prefWidth="360" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="statusFilterCombo" prefWidth="160"/>
            <ComboBox fx:id="periodPresetCombo" prefWidth="160"/>
            <Button fx:id="refreshButton" text="Обновить"/>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <TreeTableView fx:id="productionTree" showRoot="false" VBox.vgrow="ALWAYS"
                           prefHeight="420">
                <columns>
                    <TreeTableColumn fx:id="treeSelectedColumn" text="" prefWidth="48" minWidth="48"
                                     maxWidth="56"/>
                    <TreeTableColumn fx:id="treeIdentityColumn" text="Заказ / Позиция" prefWidth="220"/>
                    <TreeTableColumn fx:id="treeSecondaryColumn" text="Изделие / Заказчик" prefWidth="240"/>
                    <TreeTableColumn fx:id="treeQuantityColumn" text="Количество" prefWidth="100"/>
                    <TreeTableColumn fx:id="treeStatusColumn" text="Состояние" prefWidth="140"/>
                    <TreeTableColumn fx:id="treeReleasedColumn" text="Изготовлено" prefWidth="100"/>
                    <TreeTableColumn fx:id="treeRemainingColumn" text="Осталось" prefWidth="100"/>
                </columns>
            </TreeTableView>
        </StackPane>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="selectionCountLabel" text="Выбрано: 0 позиций"/>
            <Button fx:id="requestMaterialsButton" text="Запросить материалы"/>
            <Button fx:id="materialDraftsButton" text="Черновики материалов"/>
        </HBox>
    </VBox>

    <VBox fx:id="detailPane" spacing="12" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <HBox spacing="8">
            <Button fx:id="backToTreeButton" text="← К производству"/>
            <Button fx:id="detailRefreshButton" text="Обновить"/>
        </HBox>

        <Label fx:id="orderTitleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <VBox spacing="4">
            <HBox spacing="8">
                <Label text="Заказчик:"/>
                <Label fx:id="customerLabel"/>
            </HBox>
            <HBox spacing="8">
                <Label text="Объект:"/>
                <Label fx:id="siteLabel"/>
            </HBox>
            <HBox spacing="8">
                <Label text="Состояние:"/>
                <Label fx:id="statusLabel"/>
            </HBox>
            <HBox spacing="8">
                <Label text="Изготовлено:"/>
                <Label fx:id="progressLabel"/>
            </HBox>
        </VBox>

        <HBox spacing="8">
            <Button fx:id="acceptButton" text="Принять в производство"/>
        </HBox>

        <Separator/>

        <VBox spacing="8">
            <Label text="РЕЖИМ РАБОТЫ" style="-fx-font-weight: bold;"/>
            <fx:define>
                <ToggleGroup fx:id="quantityModeGroup"/>
            </fx:define>
            <HBox spacing="16">
                <RadioButton fx:id="standardModeRadio" text="Стандартный"
                             toggleGroup="$quantityModeGroup"/>
                <RadioButton fx:id="flexibleModeRadio" text="Гибкий"
                             toggleGroup="$quantityModeGroup"/>
            </HBox>
            <Label fx:id="quantityModeHintLabel" style="-fx-opacity: 0.8; -fx-wrap-text: true;"/>
            <HBox spacing="8">
                <Button fx:id="saveQuantityModeButton" text="Сохранить"/>
            </HBox>
        </VBox>

        <Separator/>

        <Label text="Позиции" style="-fx-font-weight: bold;"/>
        <TableView fx:id="itemsTable" prefHeight="280" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="itemPositionColumn" text="Позиция" prefWidth="120"/>
                <TableColumn fx:id="itemProductColumn" text="Изделие" prefWidth="220"/>
                <TableColumn fx:id="itemQuantityColumn" text="Кол-во" prefWidth="80"/>
                <TableColumn fx:id="itemStatusColumn" text="Состояние" prefWidth="140"/>
                <TableColumn fx:id="itemReleasedColumn" text="Изготовлено" prefWidth="100"/>
                <TableColumn fx:id="itemRemainingColumn" text="Осталось" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
